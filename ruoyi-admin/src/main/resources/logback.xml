<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    <!-- 可通过环境变量 LOG_PATH 覆盖；默认 logs（相对运行目录，便于 Windows 本地调试） -->
    <property name="log.path" value="${LOG_PATH:-logs}" />
    <property name="log.pattern" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - [%method,%line] - %msg%n" />

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/sys-info.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/sys-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="sys-user" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-user.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/sys-user.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 分类目录：定时任务调度（Quartz 包） -->
    <appender name="cat_quartz" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/category/quartz-schedule.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/category/quartz-schedule.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 分类目录：检查报警 / 运维消息聚合 -->
    <appender name="cat_alarm" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/category/alarm-maintenance.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/category/alarm-maintenance.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 分类目录：站内消息写入 -->
    <appender name="cat_message" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/category/sys-user-message.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/category/sys-user-message.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- additivity=true：同时写入根 logger（控制台 + sys-info/sys-error）与本分类文件 -->
    <logger name="com.ruoyi.quartz" level="INFO" additivity="true">
        <appender-ref ref="cat_quartz"/>
    </logger>

    <logger name="com.thor.springai.service.MaintenanceFormService" level="INFO" additivity="true">
        <appender-ref ref="cat_alarm"/>
    </logger>

    <logger name="com.ruoyi.system.task.MaintenanceFormNotifyTask" level="INFO" additivity="true">
        <appender-ref ref="cat_alarm"/>
    </logger>

    <logger name="com.ruoyi.system.service.impl.SysUserMessageServiceImpl" level="INFO" additivity="true">
        <appender-ref ref="cat_message"/>
    </logger>

    <logger name="com.ruoyi" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>

    <logger name="sys-user" level="INFO" additivity="false">
        <appender-ref ref="sys-user"/>
    </logger>

    <!-- 单一 root：控制台 + 全局 info/error 文件 -->
    <root level="INFO">
        <appender-ref ref="console"/>
        <appender-ref ref="file_info"/>
        <appender-ref ref="file_error"/>
    </root>
</configuration>
