<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EqMaintenanceRecordMapper">

    <resultMap type="com.ruoyi.system.domain.EqMaintenanceRecord" id="EqMaintenanceRecordResult">
        <id     property="recordId"           column="record_id"          />
        <result property="deviceId"           column="device_id"          />
        <result property="maintenanceType"    column="maintenance_type"    />
        <result property="maintenanceDate"    column="maintenance_date"    />
        <result property="nextMaintenanceDate" column="next_maintenance_date" />
        <result property="maintenanceCost"    column="maintenance_cost"    />
        <result property="performedBy"        column="performed_by"        />
        <result property="description"        column="description"         />
        <result property="partsReplaced"      column="parts_replaced"      />
        <result property="technicianNotes"   column="technician_notes"    />
        <result property="status"            column="status"              />
        <result property="remark"            column="remark"              />
        <result property="createBy"           column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"           column="update_by"           />
        <result property="updateTime"         column="update_time"         />
    </resultMap>

    <sql id="selectEqMaintenanceRecordVo">
        select record_id, device_id, maintenance_type, maintenance_date, next_maintenance_date, 
               maintenance_cost, performed_by, description, parts_replaced, technician_notes, 
               status, remark, create_by, create_time, update_by, update_time
        from eq_maintenance_record
    </sql>

    <select id="selectEqMaintenanceRecordList" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        <where>
            <if test="deviceId != null">AND device_id = #{deviceId}</if>
            <if test="maintenanceType != null">AND maintenance_type = #{maintenanceType}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        order by maintenance_date desc
    </select>

    <select id="selectEqMaintenanceRecordByRecordId" parameterType="Long" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        where record_id = #{recordId}
    </select>

    <select id="selectEqMaintenanceRecordListByDeviceId" parameterType="Long" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        where device_id = #{deviceId}
        order by maintenance_date desc
    </select>

    <insert id="insertEqMaintenanceRecord" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into eq_maintenance_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="maintenanceType != null">maintenance_type,</if>
            <if test="maintenanceDate != null">maintenance_date,</if>
            <if test="nextMaintenanceDate != null">next_maintenance_date,</if>
            <if test="maintenanceCost != null">maintenance_cost,</if>
            <if test="performedBy != null and performedBy != ''">performed_by,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="partsReplaced != null and partsReplaced != ''">parts_replaced,</if>
            <if test="technicianNotes != null and technicianNotes != ''">technician_notes,</if>
            <if test="status != null">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="maintenanceType != null">#{maintenanceType},</if>
            <if test="maintenanceDate != null">#{maintenanceDate},</if>
            <if test="nextMaintenanceDate != null">#{nextMaintenanceDate},</if>
            <if test="maintenanceCost != null">#{maintenanceCost},</if>
            <if test="performedBy != null and performedBy != ''">#{performedBy},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="partsReplaced != null and partsReplaced != ''">#{partsReplaced},</if>
            <if test="technicianNotes != null and technicianNotes != ''">#{technicianNotes},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateEqMaintenanceRecord" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord">
        update eq_maintenance_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="maintenanceType != null">maintenance_type = #{maintenanceType},</if>
            <if test="maintenanceDate != null">maintenance_date = #{maintenanceDate},</if>
            <if test="nextMaintenanceDate != null">next_maintenance_date = #{nextMaintenanceDate},</if>
            <if test="maintenanceCost != null">maintenance_cost = #{maintenanceCost},</if>
            <if test="performedBy != null and performedBy != ''">performed_by = #{performedBy},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="partsReplaced != null and partsReplaced != ''">parts_replaced = #{partsReplaced},</if>
            <if test="technicianNotes != null and technicianNotes != ''">technician_notes = #{technicianNotes},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteEqMaintenanceRecordByRecordId" parameterType="Long">
        delete from eq_maintenance_record where record_id = #{recordId}
    </delete>

    <delete id="deleteEqMaintenanceRecordByRecordIds">
        delete from eq_maintenance_record where record_id in 
        <foreach item="recordId" collection="recordIds" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deleteEqMaintenanceRecordByDeviceId" parameterType="Long">
        delete from eq_maintenance_record where device_id = #{deviceId}
    </delete>

    <delete id="deleteEqMaintenanceRecordByDeviceIds">
        delete from eq_maintenance_record where device_id in 
        <foreach item="deviceId" collection="deviceIds" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>
</mapper>
