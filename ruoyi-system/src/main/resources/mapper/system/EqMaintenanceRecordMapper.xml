<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EqMaintenanceRecordMapper">
    
    <resultMap type="com.ruoyi.system.domain.EqMaintenanceRecord" id="EqMaintenanceRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="deviceNo"    column="device_no"    />
        <result property="deviceName"    column="device_name"    />
        <result property="maintenanceType"    column="maintenance_type"    />
        <result property="maintenanceDate"    column="maintenance_date"    />
        <result property="nextMaintenanceDate"    column="next_maintenance_date"    />
        <result property="maintenanceCost"    column="maintenance_cost"    />
        <result property="performedBy"    column="performed_by"    />
        <result property="description"    column="description"    />
        <result property="partsReplaced"    column="parts_replaced"    />
        <result property="technicianNotes"    column="technician_notes"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqMaintenanceRecordVo">
        select m.record_id, m.device_id, m.maintenance_type, m.maintenance_date, m.next_maintenance_date, m.maintenance_cost, m.performed_by, m.description, m.parts_replaced, m.technician_notes, m.status, m.remark,
        d.device_no, d.device_name
        from eq_maintenance_record m
        left join eq_device d on m.device_id = d.device_id
    </sql>

    <select id="selectEqMaintenanceRecordList" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        <where>  
            <if test="deviceId != null "> and m.device_id = #{deviceId}</if>
            <if test="deviceNo != null and deviceNo != ''"> and d.device_no like concat('%', #{deviceNo}, '%')</if>
            <if test="deviceName != null and deviceName != ''"> and d.device_name like concat('%', #{deviceName}, '%')</if>
            <if test="maintenanceType != null "> and m.maintenance_type = #{maintenanceType}</if>
            <if test="status != null "> and m.status = #{status}</if>
        </where>
        order by m.maintenance_date desc
    </select>
    
    <select id="selectEqMaintenanceRecordByRecordId" parameterType="Long" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        where m.record_id = #{recordId}
    </select>

    <select id="selectEqMaintenanceRecordListByDeviceId" parameterType="String" resultMap="EqMaintenanceRecordResult">
        <include refid="selectEqMaintenanceRecordVo"/>
        where m.device_id = #{deviceId}
        order by m.maintenance_date desc
    </select>
        
    <insert id="insertEqMaintenanceRecord" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord">
        insert into eq_maintenance_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordId != null">record_id,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="maintenanceType != null">maintenance_type,</if>
            <if test="maintenanceDate != null">maintenance_date,</if>
            <if test="nextMaintenanceDate != null">next_maintenance_date,</if>
            <if test="maintenanceCost != null">maintenance_cost,</if>
            <if test="performedBy != null">performed_by,</if>
            <if test="description != null">description,</if>
            <if test="partsReplaced != null">parts_replaced,</if>
            <if test="technicianNotes != null">technician_notes,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recordId != null">#{recordId},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="maintenanceType != null">#{maintenanceType},</if>
            <if test="maintenanceDate != null">#{maintenanceDate},</if>
            <if test="nextMaintenanceDate != null">#{nextMaintenanceDate},</if>
            <if test="maintenanceCost != null">#{maintenanceCost},</if>
            <if test="performedBy != null">#{performedBy},</if>
            <if test="description != null">#{description},</if>
            <if test="partsReplaced != null">#{partsReplaced},</if>
            <if test="technicianNotes != null">#{technicianNotes},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateEqMaintenanceRecord" parameterType="com.ruoyi.system.domain.EqMaintenanceRecord">
        update eq_maintenance_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="maintenanceType != null">maintenance_type = #{maintenanceType},</if>
            <if test="maintenanceDate != null">maintenance_date = #{maintenanceDate},</if>
            <if test="nextMaintenanceDate != null">next_maintenance_date = #{nextMaintenanceDate},</if>
            <if test="maintenanceCost != null">maintenance_cost = #{maintenanceCost},</if>
            <if test="performedBy != null">performed_by = #{performedBy},</if>
            <if test="description != null">description = #{description},</if>
            <if test="partsReplaced != null">parts_replaced = #{partsReplaced},</if>
            <if test="technicianNotes != null">technician_notes = #{technicianNotes},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteEqMaintenanceRecordByRecordId" parameterType="Long">
        delete from eq_maintenance_record where record_id = #{recordId}
    </delete>

    <delete id="deleteEqMaintenanceRecordByRecordIds">
        delete from eq_maintenance_record where record_id in 
        <foreach item="recordId" collection="recordIds" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deleteEqMaintenanceRecordByDeviceId" parameterType="String">
        delete from eq_maintenance_record where device_id = #{deviceId}
    </delete>

    <delete id="deleteEqMaintenanceRecordByDeviceIds">
        delete from eq_maintenance_record where device_id in 
        <foreach item="deviceId" collection="deviceIds" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>
</mapper>
